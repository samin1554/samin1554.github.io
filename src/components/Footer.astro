---
import Icon from "./Icon.astro";
import { profile } from "../data/profile";

const iconFor = { github: "github", linkedin: "linkedin", scholar: "scholar", mail: "mail" } as const;
const year = new Date().getFullYear();
---

<footer id="contact" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
  <div
    class="reveal rounded-2xl border border-line bg-surface/50 p-8 text-center sm:p-12"
  >
    <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent">
      Get in touch
    </p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-fg sm:text-3xl">
      Say hello.
    </h2>
    <p class="mx-auto mt-3 max-w-md text-muted">
      I'm looking for software engineering internships and new-grad roles, and
      I'm always happy to chat. Email or LinkedIn is the easiest way to reach me.
    </p>

    <div class="mt-7 flex flex-wrap justify-center gap-3">
      {
        profile.socials.map((s) => (
          <a
            href={s.href}
            target={s.icon === "mail" ? undefined : "_blank"}
            rel={s.icon === "mail" ? undefined : "noopener noreferrer"}
            class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent"
          >
            <Icon name={iconFor[s.icon]} class="h-4 w-4" />
            {s.label}
          </a>
        ))
      }
    </div>
  </div>

  <div
    class="mt-8 flex flex-col items-center justify-between gap-2 text-sm text-muted sm:flex-row"
  >
    <p>© {year} {profile.fullName}</p>
    <p class="font-mono text-xs">Built with Astro &amp; Tailwind</p>
  </div>
</footer>
