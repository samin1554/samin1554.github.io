---
import Section from "./Section.astro";
import { experience } from "../data/experience";
---

<Section id="experience" eyebrow="02 / Path" title="Experience">
  <ol class="relative border-l border-line pl-6">
    {
      experience.map((job) => (
        <li class="reveal mb-10 last:mb-0">
          <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full border-2 border-bg bg-accent" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="text-base font-semibold text-fg">
              {job.role}
              <span class="text-muted"> · {job.org}</span>
              {job.orgNote && (
                <span class="ml-2 rounded bg-accent-soft px-1.5 py-0.5 align-middle font-mono text-[11px] font-medium text-accent">
                  {job.orgNote}
                </span>
              )}
            </h3>
            <p class="font-mono text-xs text-muted">{job.period}</p>
          </div>
          <p class="mt-0.5 text-sm text-muted">{job.location}</p>
          <ul class="mt-3 space-y-2">
            {job.bullets.map((b) => (
              <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
