---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { openSource } from "../data/openSource";
---

<Section id="open-source" eyebrow="03 / Community" title="Open Source">
  <div class="grid gap-4 sm:grid-cols-3">
    {
      openSource.map((c) => (
        <article class="reveal flex h-full flex-col rounded-xl border border-line bg-surface/50 p-5">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-semibold text-fg">{c.project}</h3>
            {c.link && (
              <a
                href={c.link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-md bg-surface-2 px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:text-accent"
              >
                {c.link.label}
                <Icon name="external" class="h-3 w-3" />
              </a>
            )}
          </div>
          {c.org && (
            <p class="mt-0.5 font-mono text-xs text-muted">{c.org}</p>
          )}
          <p class="mt-3 text-sm leading-relaxed text-muted">{c.summary}</p>
        </article>
      ))
    }
  </div>
</Section>
