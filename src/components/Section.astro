---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  class?: string;
}
const { id, eyebrow, title, class: className = "" } = Astro.props;
---

<section id={id} class={`mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20 ${className}`}>
  <div class="reveal">
    <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent">
      {eyebrow}
    </p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl">
      {title}
    </h2>
  </div>
  <div class="mt-8">
    <slot />
  </div>
</section>
